# Supabase: Project Settings > Database > Connection string (URI). Use the pooler string for Render.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
PORT=5000
# Frontend URL allowed by CORS (comma-separated for several)
CLIENT_URL=http://localhost:5173
# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@k12hunar.com
ADMIN_PASSWORD=Admin@12345
